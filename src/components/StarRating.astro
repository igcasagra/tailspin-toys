---
import { clampRating, formatRatingLabel, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    showScale?: boolean;
    showUnrated?: boolean;
}

const { rating, showScale = false, showUnrated = false } = Astro.props;
const ratingLabel = formatRatingLabel(rating);
---

{(rating !== null || showUnrated) && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            {rating !== null && (
                <span class="text-yellow-400" aria-hidden="true">{formatStarRating(rating)}</span>
            )}
            {rating === null || showScale ? ratingLabel : clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
